{# Pesquisa e paginação preservam os filtros da lista. #}
{% extends 'base.html.twig' %}
{% block title %}{{ metadados.label }} · Acervo{% endblock %}
{% block body %}
<div class="list-heading">
    <h1>{{ metadados.label }}</h1>
    <a class="btn btn-primary add-button" href="{{ path(tipo ~ '_novo') }}">
        <svg class="add-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
        </svg>
        <span>Adicionar</span>
    </a>
</div>
<div class="panel catalog-panel">
    <form class="list-toolbar" method="get">
        <div class="search-controls">
            <label class="visually-hidden" for="search">Pesquisar</label>
            <input class="form-control search" id="search" name="q" value="{{ busca }}" placeholder="Pesquisar por nome">
            <button class="btn btn-outline-secondary">Pesquisar</button>
            {% if busca %}
            <a class="btn btn-link" href="{{ path(tipo ~ '_lista', {porPagina}) }}">Limpar</a>
            {% endif %}
        </div>
        <div class="list-options">
            <div class="page-size">
                <label for="per-page">Itens por página</label>
                <select id="per-page" class="form-select form-select-sm" name="porPagina" onchange="this.form.requestSubmit()">
                    {% for quantidade in [5, 10, 25, 50, 0] %}
                    <option value="{{ quantidade }}" {{ quantidade == porPagina ? 'selected' : '' }}>{{ quantidade == 0 ? 'Tudo' : quantidade }}</option>
                    {% endfor %}
                </select>
                <noscript>
                    <button class="btn btn-sm btn-outline-secondary">Aplicar</button>
                </noscript>
            </div>
        </div>
    </form>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>

                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for registro in registros %}
                <tr>
                    <td class="text-secondary">{{ attribute(registro, metadados.id) }}</td>
                    <td class="fw-semibold">{{ attribute(registro, metadados.field) }}</td>

                    <td>
                        <div class="d-flex justify-content-end gap-2">
                            <a class="btn btn-sm btn-outline-secondary icon-button" href="{{ path(tipo ~ '_editar', {id: attribute(registro, metadados.id)}) }}" aria-label="Editar {{ attribute(registro, metadados.field) }}" title="Editar">
                                <svg class="action-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m16 3 5 5M4 20l4.5-1L21 6.5a2.1 2.1 0 0 0-3-3L5.5 16Z"/>
                                </svg>
                            </a>
                            <form method="post" action="{{ path(tipo ~ '_excluir', {id: attribute(registro, metadados.id)}) }}" onsubmit="return confirm('Excluir este cadastro? Esta ação não pode ser desfeita.')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ tipo ~ '_' ~ attribute(registro, metadados.id)) }}">
                                <button class="btn btn-sm btn-outline-danger icon-button" aria-label="Excluir {{ attribute(registro, metadados.field) }}" title="Excluir">
                                    <svg class="action-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 6h18M9 6V4h6v2M5 6l1 14h12l1-14M10 10v6M14 10v6"/>
                                    </svg>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="3" class="text-center text-secondary py-5">Nenhum registro encontrado. Use o botão acima para cadastrar.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="list-footer">
        <span class="range-summary">
            {% if total %}Exibindo {{ deslocamento + 1 }}–{{ deslocamento + registros|length }} de {{ total }} registros{% else %}Nenhum registro para exibir{% endif %}
        </span>
        <nav aria-label="Paginação">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item {{ pagina == 1 ? 'disabled' : '' }}">
                    {% if pagina > 1 %}
                    <a class="page-link" href="{{ path(tipo ~ '_lista', {q: busca, porPagina, pagina: pagina - 1}) }}">Anterior</a>
                    {% else %}
                    <span class="page-link" aria-disabled="true">Anterior</span>
                    {% endif %}
                </li>
                {% for numero in 1..paginas %}
                {% if numero == 1 or numero == paginas or (numero >= pagina - 2 and numero <= pagina + 2) %}
                <li class="page-item {{ numero == pagina ? 'active' : '' }}">
                    {% if numero == pagina %}
                    <span class="page-link" aria-current="page">{{ numero }}</span>
                    {% else %}
                    <a class="page-link" href="{{ path(tipo ~ '_lista', {q: busca, porPagina, pagina: numero}) }}">{{ numero }}</a>
                    {% endif %}
                </li>
                {% elseif numero == pagina - 3 or numero == pagina + 3 %}
                <li class="page-item disabled">
                    <span class="page-link">…</span>
                </li>
                {% endif %}
                {% endfor %}
                <li class="page-item {{ pagina == paginas ? 'disabled' : '' }}">
                    {% if pagina < paginas %}
                    <a class="page-link" href="{{ path(tipo ~ '_lista', {q: busca, porPagina, pagina: pagina + 1}) }}">Próxima</a>
                    {% else %}
                    <span class="page-link" aria-disabled="true">Próxima</span>
                    {% endif %}
                </li>
            </ul>
        </nav>
    </div>
</div>
{% endblock %}
