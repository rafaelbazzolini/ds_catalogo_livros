{
  "name": "rafael/catalogo-livros",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "symfony/framework-bundle": "^7.4",
    "symfony/console": "^7.4",
    "symfony/runtime": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/twig-bundle": "^7.4",
    "symfony/security-csrf": "^7.4",
    "doctrine/dbal": "^4.3",
    "dompdf/dompdf": "^3.1",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  }
}
